{
  "manifest_version": 3,
  "name": "Ajay AutoFlow",
  "short_name": "Ajay Flow",
  "description": "Batch-run Google Flow prompts: queue images and videos, pick characters and voices, and save every clip with a clean, timecoded filename.",
  "version": "1.3.0",
  "action": {
    "default_title": "Ajay AutoFlow",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "permissions": [
    "storage",
    "tabs",
    "sidePanel",
    "activeTab",
    "downloads",
    "debugger"
  ],
  "host_permissions": [
    "*://flow.google.com/*",
    "*://labs.google/*",
    "*://*.googleusercontent.com/*",
    "*://storage.googleapis.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://flow.google.com/*",
        "*://labs.google/fx/*"
      ],
      "js": [
        "content/page-upload.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "*://flow.google.com/*",
        "*://labs.google/fx/*"
      ],
      "js": [
        "content/jquery.min.js",
        "content/selectors.js",
        "content/helpers.js",
        "content/flow.js",
        "content/queue.js"
      ],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "offline_enabled": true,
  "minimum_chrome_version": "116"
}
